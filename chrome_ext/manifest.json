{
  "manifest_version": 3,
  "name": "PhishGuard - Anti-Phishing AI",
  "version": "0.1",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["http://localhost:8000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "PhishGuard Scanner",
    "default_popup": "popup.html"
  }
}
